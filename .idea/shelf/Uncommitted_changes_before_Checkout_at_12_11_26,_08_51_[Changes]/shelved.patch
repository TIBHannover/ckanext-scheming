<+># TRR375 dataset metadata schema\n# Use with ckanext-scheming (scheming_datasets).\nscheming_version: 2\ndataset_type: dataset\nabout: TRR375 dataset metadata schema\n\ndataset_fields:\n  # STEP 1 — CKAN core metadata\n  - field_name: title\n    label: Title\n    preset: title\n    required: true\n    form_placeholder: Characterization of AlSi10Mg porous samples\n\n  - field_name: name\n    label: Dataset URL / Slug\n    preset: dataset_slug\n    required: true\n    form_placeholder: characterization-alsi10mg-porous-samples\n\n  - field_name: notes\n    label: Description\n    preset: markdown\n    required: true\n    form_placeholder: Experimental characterization of porous AlSi10Mg specimens...\n\n  - field_name: owner_org\n    label: Organization\n    preset: dataset_organization\n    required: true\n\n#  # Dataset visibility (Public by default)\n#  - field_name: private\n#    label: Visibility\n#    preset: select\n#    required: true\n#    default: 'True'\n#    choices:\n#      - value: 'False'\n#        label: Public\n#      - value: 'True'\n#        label: Private\n#    help_text: Public is selected by default. You can change it to Private if needed.\n\n  - field_name: author\n    label: Author\n    repeating_label: Author\n    repeating_collapse: true\n    repeating_grid: true\n    required: true\n    validators: scheming_required unicode_safe\n # This is for RADAR implementation and for general repeating author. on RADAR this is mapped to Creator.\n    repeating_subfields:\n\n      - field_name: given_name\n        label: Given Name\n        required: true\n\n      - field_name: family_name\n        label: Family Name\n        required: true\n\n      - field_name: orcid\n        label: ORCID\n        required: false\n        help_text: \"ORCID iD of the researcher\"\n\n      - field_name: affiliation\n        label: Affiliation\n        required: false\n\n      - field_name: affiliation_ror\n        label: Affiliation ROR\n        required: false\n        help_text: \"ROR identifier of the affiliated institution\"\n\n  - field_name: tag_string\n    label: Keywords\n    preset: tag_string_autocomplete\n    form_placeholder: porous material, AlSi10Mg, additive manufacturing, X-ray CT\n    help_text: Controlled vocabulary for keywords can be integrated later.\n\n  - field_name: license_id\n    label: License\n    form_snippet: license.html\n    required: true\n    validators: scheming_required unicode_safe\n    help_text: Select a license, for example CC BY 4.0 or CC BY-SA 4.0 (if configured).\n\n  - field_name: maintainer\n    label: Maintainer / Contact Person\n    required: true\n    validators: scheming_required unicode_safe\n    form_placeholder: Max Mustermann\n\n  - field_name: maintainer_email\n    label: Contact Email\n    required: true\n    validators: scheming_required unicode_safe strip_value email_validator\n    form_placeholder: max.mustermann@uni-hannover.de\n\n  - field_name: version\n    label: Dataset Version\n    validators: ignore_missing unicode_safe package_version_validator\n    form_placeholder: '1.0'\n    help_text: Recommended.\n\n  - field_name: url\n    label: Related Web Page\n    display_snippet: link.html\n    validators: ignore_missing unicode_safe\n    form_placeholder: https://www.trrhypo.de/\n\n  # TRR375 project metadata\n  # TRR375 project metadata - Dynamic CKAN group selection\n  - field_name: project_id\n    label: TRR375 Subproject\n    form_snippet: trr375_group_select.html\n    validators: scheming_required unicode_safe\n    required: true\n    form_include_blank_choice: true\n    help_text: Select the TRR375 subproject from the existing CKAN groups.\n\n  - field_name: project_area\n    label: Project Area\n    preset: select\n    required: true\n    form_include_blank_choice: true\n    choices:\n      - {value: A, label: A}\n      - {value: B, label: B}\n      - {value: C, label: C}\n      - {value: S, label: S}\n\n  # FAIR / publication metadata\n  - field_name: doi\n    label: DOI\n    form_placeholder: 10.5281/zenodo.xxxxx\n    validators: ignore_missing unicode_safe\n    help_text: Conditional; add the DOI after publication in an external repository. This field does not generate a DOI.\n\n  - field_name: related_publication\n    label: Related Publication\n    validators: ignore_missing unicode_safe\n    form_placeholder: https://doi.org/10.1016/j...\n    help_text: DOI or URL of a related publication.\n\n  - field_name: related_dataset\n    label: Related Dataset\n    validators: ignore_missing unicode_safe\n    form_placeholder: TRR375-B01-001\n    help_text: Dataset identifier/reference. A CKAN dataset picker or one-to-many relationship needs separate implementation.\n\n  - field_name: funding_reference\n    label: Funding / Project Identifier\n    default: TRR 375\n    validators: ignore_missing unicode_safe\n    help_text: Recommended. Prefilled with TRR 375.\n\n# STEP 2 — CKAN resource metadata\n# IMPORTANT: Resource field names in the workbook are descriptive aliases;\n# native CKAN keys must be url, name, description, format.\nresource_fields:\n  - field_name: url\n    label: File/Resource\n    preset: resource_url_upload\n    required: true\n    upload_label: File/Resource\n\n  - field_name: name\n    label: Resource Name\n    required: true\n    validators: scheming_required unicode_safe\n    form_placeholder: Measurement data\n\n  - field_name: description\n    label: Resource Description\n    preset: markdown\n    required: true\n\n  - field_name: format\n    label: File Format\n    preset: resource_format_autocomplete\n    required: true\n    help_text: For example CSV, TIFF or JSON.\n
